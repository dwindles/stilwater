<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>StilwaterLauncher</AssemblyName>
    <RootNamespace>Stilwater.Launcher</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.2.0</Version>
    <Product>Stilwater</Product>
    <Company>holdonquietly.com</Company>
    <Authors>holdonquietly.com</Authors>
    <Description>Saints Row 2 custom client by holdonquietly.com</Description>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('assets\logo.ico')">
    <ApplicationIcon>assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="assets\logo.ico" Condition="Exists('assets\logo.ico')" CopyToOutputDirectory="PreserveNewest" />
    <!-- The window's web UI (MainForm, Bridge); mock.js only serves previews in a browser. -->
    <None Include="ui\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- The WebView2 package always references its WPF control too; this is a WinForms app. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
